ZUT_AUTH_TOKEN=replace-with-a-long-random-token
ZUT_ENGINE=pdf2zh_next
ZUT_ENABLED_ENGINES=pdf2zh_next
ZUT_ALLOW_MOCK_ENGINE=0
ZUT_MAX_FILE_BYTES=104857600
ZUT_MAX_PAGES=200
ZUT_ARTIFACT_TTL_DAYS=7
ZUT_WORKER_POLL_SECONDS=1

# Legacy CLI adapter only. pdf2zh_next uses its native Python API.
ZUT_PDF2ZH_COMMAND=

ZUT_LLM_PROVIDER=openai
ZUT_LLM_ENDPOINT=https://api.openai.com/v1
ZUT_LLM_MODEL=gpt-4o-mini
ZUT_LLM_API_KEY=
